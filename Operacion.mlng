const int BASE = 10
const double PI = 3.1416

funcion calcular(double radio, int b):
    double area = PI * radio * radio
    int suma = BASE + b
    int resta = BASE - b
    int producto = BASE * b
    int division = BASE / b
    if suma > 10:
        string mensaje = "resultado grande"
        write(mensaje)
    return area

double radioValor = 5.0
int bValor = 3
calcular(radioValor, bValor)