const int TOPE = 10
const double LIMITE = 5.5
double x = 3.5
int y = 20
int z = 15
bool activo = true

if x < TOPE
    write("x es menor")
    if y > z
        write("y supera z")
    else:
        write("z supera y")
else:
    write("x supera el tope")

while y > 0
    y = y - 1
    write(y)

while activo and z > 0
    z = z - 1

